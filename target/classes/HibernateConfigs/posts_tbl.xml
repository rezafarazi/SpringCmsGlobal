<?xml version = "1.0" encoding = "utf-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name = "com.sorapp.jowncms.jowncms.Models.posts_tbl" table = "posts_tbl">

        <meta attribute = "class-description">
            This class contains the employee detail.
        </meta>

        <id name = "id" type = "int" column = "id">
            <generator class="native"/>
        </id>

        <property name = "title" column = "title" type = "string"/>
        <property name = "content" column = "content" type = "string"/>
        <property name = "enabled_flag" column = "enabled_flag" type = "string"/>
        <property name = "edit_time" column = "edit_time" type = "string"/>
        <property name = "user_id" column = "user_id" type = "int"/>
        <property name = "category_id" column = "category_id" type = "int"/>
        <property name = "image_address" column = "image_address" type = "string"/>



    </class>
</hibernate-mapping>