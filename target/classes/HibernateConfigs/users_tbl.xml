<?xml version = "1.0" encoding = "utf-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name = "com.sorapp.jowncms.jowncms.Models.users_tbl" table = "users_tbl">

        <meta attribute = "class-description">
            This class contains the employee detail.
        </meta>

        <id name = "id" type = "int" column = "id">
            <generator class="native"/>
        </id>

        <property name = "name" column = "name" type = "string"/>
        <property name = "family" column = "family" type = "string"/>
        <property name = "username" column = "username" type = "string"/>
        <property name = "password" column = "password" type = "string"/>
        <property name = "login_token" column = "login_token" type = "string"/>
        <property name = "google2f" column = "google2f" type = "string"/>
        <property name = "user_type" column = "user_type" type = "string"/>
        <property name = "active_user_flag" column = "active_user_flag" type = "string"/>
        <property name = "create_datetime" column = "create_datetime" type = "string"/>
        <property name = "email" column = "email" type = "string"/>
        <property name = "address" column = "address" type = "string"/>
        <property name = "city" column = "city" type = "string"/>
        <property name = "phone" column = "phone" type = "string"/>


    </class>
</hibernate-mapping>